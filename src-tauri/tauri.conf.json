{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MailPilot",
  "version": "0.1.0",
  "identifier": "ai.mailpilot.desktop",
  "build": {
    "frontendDist": "../apps/desktop/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:local",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "MailPilot",
        "width": 1440,
        "height": 920,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
