{
  "name": "mailpilot",
  "private": true,
  "version": "0.1.0",
  "description": "本地优先的 Agentic 邮箱工作台",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @mailpilot/desktop dev",
    "dev:local": "./scripts/dev-local.sh",
    "tauri:dev": ". \"$HOME/.cargo/env\" && tauri dev",
    "tauri:build": ". \"$HOME/.cargo/env\" && tauri build",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
